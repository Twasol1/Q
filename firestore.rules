rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    function okProduct() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.desc is string && d.desc.size() <= 2000
        && d.price is string && d.price.size() <= 40
        && d.cat is string && d.cat.size() <= 40
        && d.img is string && d.img.size() <= 300000;
    }
    // المنتجات والإعدادات: قراءة للجميع، كتابة للمشرف فقط
    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && okProduct();
      allow delete: if isAdmin();
    }
    match /config/{d} { allow read: if true; allow write: if isAdmin(); }
    // قائمة المشرفين: لا قراءة إلا لصاحب الوثيقة، ولا كتابة من التطبيق
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
  }
}
