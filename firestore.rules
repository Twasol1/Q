rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function notBanned() {
      return signed() && !(get(/databases/$(db)/documents/users/$(request.auth.uid)).data.banned == true);
    }

    // إعدادات التطبيق: قراءة للجميع، كتابة للمشرف فقط
    match /config/{d} { allow read: if true; allow write: if isAdmin(); }

    // قائمة المشرفين: يقرأ المستخدم وثيقته فقط، ولا أحد يكتب من التطبيق
    match /admins/{uid} { allow read: if signed() && request.auth.uid == uid; allow write: if false; }

    match /users/{uid} {
      allow read: if signed();
      allow create: if signed() && request.auth.uid == uid && request.resource.data.banned == false;
      // المستخدم لا يستطيع تغيير حالة الحظر عن نفسه
      allow update: if (signed() && request.auth.uid == uid && request.resource.data.banned == resource.data.banned) || isAdmin();
      allow delete: if isAdmin();
    }

    match /rooms/{r} {
      allow read: if notBanned();
      allow write: if isAdmin();
      match /messages/{m} {
        allow read: if notBanned();
        allow create: if notBanned()
          && request.resource.data.keys().hasOnly(['uid','name','text','ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow delete: if isAdmin();
        allow update: if false;
      }
    }
  }
}
